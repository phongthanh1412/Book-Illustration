# Copy to server/.env and fill in. Never commit the real .env.

# Your Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Current text and image ("Nano Banana" family) model IDs. Model names change
# over time; check the Gemini API docs for the current ones if these 404.
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Server port and the frontend origin allowed to call it (CORS + cookies).
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Signs the session cookie. Any random string is fine for local dev.
COOKIE_SECRET=change-me-to-anything

# Where JSON data, book text, and generated images are stored on disk.
DATA_DIR=./data
